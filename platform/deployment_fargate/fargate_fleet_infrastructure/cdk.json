{
  "app": "bash -c 'PYTHONPATH=../../.. uv run --extra cdk python -m platform.deployment_fargate.fargate_fleet_infrastructure.app'",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
